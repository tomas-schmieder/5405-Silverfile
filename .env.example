# Copy to .env; never commit credentials.
# Optional. With a key, documents are read with Anthropic vision; without one, with built-in OCR.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-opus-5-5. Override with another vision + structured-output model.
ANTHROPIC_MODEL=
# auto: Anthropic when ANTHROPIC_API_KEY is set, otherwise offline. Or force anthropic / offline.
SILVERFILE_LLM_MODE=auto
SILVERFILE_VAR_DIR=./var
SILVERFILE_CONTEXT_STRATEGY=true
# Built-in OCR for document images in offline mode (models bundled, no network). 0 turns it off.
SILVERFILE_ENABLE_NATIVE_OCR=1
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
