# Copy to .env; never commit credentials.
ANTHROPIC_API_KEY=
# Set a model available to your account that supports vision and structured output.
ANTHROPIC_MODEL=
SILVERFILE_LLM_MODE=anthropic
SILVERFILE_VAR_DIR=./var
SILVERFILE_CONTEXT_STRATEGY=true
SILVERFILE_ENABLE_NATIVE_OCR=0
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
